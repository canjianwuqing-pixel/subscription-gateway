DATABASE_PATH=/data/subscription-gateway.db
GATEWAY_DOMAIN=CHANGE_ME_FQDN
GATEWAY_HTTPS_PORT=443
ADMIN_BIND=0.0.0.0
ADMIN_PORT=64444
CERT_MODE=existing
APP_UID=82
APP_GID=82
TZ=UTC
TOKEN_EVENT_LOG_PATH=/var/log/subscription-gateway/token-events.log
ACTIVE_CERT_PATH=/ssl/active/fullchain.pem
DNS_RESOLVER=127.0.0.11
TRUSTED_PROXY_IPS=
REAL_IP_HEADER=X-Forwarded-For

# 仅允许一个URL安全路径段；首次正式安装时必须自动生成并替换。
ADMIN_SECRET_PATH=CHANGE_ME_RANDOM_PATH
SESSION_NAME=subscription_gateway_session
SESSION_COOKIE_SECURE=true
LOGIN_RATE_DIR=/tmp/subscription-gateway-login-rate

# 分别生成32字节随机值后进行Base64编码。两个密钥不得相同。
TOKEN_HMAC_KEY=CHANGE_ME_BASE64_32_BYTES
TOKEN_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
